{
  "name": "airia-executive-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "check": "tsc -b && npm run check:palette",
    "check:palette": "node scripts/validate-palette.mjs",
    "chrome": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --remote-debugging-port=9222 --user-data-dir=/tmp/airia-exec-chrome about:blank",
    "build:html": "tsc -b && vite build --config vite.standalone.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
